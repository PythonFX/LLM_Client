# minimax anthropic compatible API
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
ANTHROPIC_AUTH_TOKEN=ANTHROPIC_AUTH_TOKEN
ANTHROPIC_MODEL=MiniMax-M2.7-highspeed

# anthropic: use minimax's anthropic compatible
# openai: use real openai
# minimax: use minimax's openai compatible
DEFAULT_LLM_PROVIDER=anthropic

# minimax OpenAI compatible API
OPENAI_BASE_URL=https://api.minimaxi.com/v1
OPENAI_API_KEY=ANTHROPIC_AUTH_TOKEN
OPENAI_MODEL=MiniMax-M2.7-highspeed

# azure openai gpt-4o
#AZURE_OPENAI_ENDPOINT=AZURE_OPENAI_ENDPOINT
#AZURE_OPENAI_MODEL=gpt-4o
#OPENAI_API_KEY=OPENAI_API_KEY
#OPENAI_API_VERSION=OPENAI_API_VERSION
#OPENAI_MODEL_VERSION=OPENAI_MODEL_VERSION

# azure openai gpt-5.1
AZURE_OPENAI_ENDPOINT=AZURE_OPENAI_ENDPOINT
AZURE_OPENAI_MODEL=gpt-5.1
AZURE_DEPLOYMENT=gpt-5.1
AZURE_OPENAI_API_VERSION=AZURE_OPENAI_API_VERSION
AZURE_OPENAI_MODEL_VERSION=AZURE_OPENAI_MODEL_VERSION

STAFF_ID=STAFF_ID
STAFF_PW=STAFF_PW
AZURE_PROXY_URL=PROXY_URL
AZURE_TENANT_ID=AZURE_TENANT_ID
AZURE_CLIENT_ID=AZURE_CLIENT_ID
AZURE_CLIENT_SECRET=AZURE_CLIENT_SECRET
AZURE_TOKEN_URL=https://login.microsoftonline.com/xxx/oauth2/v2.0/token
